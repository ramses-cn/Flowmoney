# =============================================================
# FLOWMONEY — Variables de entorno (ejemplo)
# =============================================================
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA commitear .env.local con secretos reales.

# ───── Gemini AI ─────
# API key de Google AI Studio (server-side only).
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Modelo Gemini a utilizar (default: gemini-2.5-flash).
# Alternativas: gemini-2.0-flash, gemini-2.5-pro
GEMINI_MODEL="gemini-2.5-flash"

# ───── App URL ─────
# URL pública del servicio (Cloud Run la inyecta automáticamente).
APP_URL="http://localhost:3000"

# ───── Cloud SQL / PostgreSQL ─────
# Formato: project:region:instance
INSTANCE_CONNECTION_NAME=""
DB_USER="postgres"
DB_PASS=""
DB_NAME="flowmoney"

# Alternativa: cadena de conexión directa (precede sobre INSTANCE_CONNECTION_NAME)
DATABASE_URL=""

# ───── Firebase ─────
FIREBASE_PROJECT_ID="symbolic-melody-kw532"

# ───── CORS (F5) ─────
# Lista separada por comas de orígenes permitidos.
# Ejemplo: "https://app.flowmoney.com,https://staging.flowmoney.com"
# Vacío = sólo same-origin
CORS_ALLOWED_ORIGINS=""

# ───── Auth / Demo mode (F19) ─────
# Habilita el bypass de autenticación para tokens demo.
# NUNCA activar en producción.
ALLOW_DEMO_AUTH="false"

# ───── SMTP / Email (F8) ─────
# Si no se configuran, los emails se loguean en consola (modo desarrollo).
# En producción, configurar con credenciales reales de SendGrid/Mailgun/SES.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FlowMoney <noreply@flowmoney.app>"

# ───── Server / Runtime ─────
# Cloud Run inyecta PORT=8080 automáticamente.
PORT="3000"
NODE_ENV="development"

# ───── Admin (F4) ─────
# Lista separada por comas de emails Master Admin adicionales.
# Correo del propietario por defecto hardcoded en admin.middleware.ts
MASTER_ADMIN_EMAILS=""
